# Aperture: 2D and 3D games in Flywheel.
#
#     import aperture as ap
#
#     ap.open("Hello", 800, 450)
#     while ap.frame() do
#         ap.clear(ap.NAVY)
#         ap.text("Hello, Aperture!", 24, 24, 32)
#     end
#     ap.close()
#
# Coordinates are doubles with y pointing down in 2D and up in 3D, angles are degrees, and
# colors are 0 to 255. Drawing happens between two calls of frame().
import c native.backend as nat
import gc
import math

# --- Values ----------------------------------------------------------------------------------

# Vec2, Vec3, Vec4, Mat4, and Quat are the built-in vecmath types, available as ap.Vec2 and so
# on: values made here and in any other library that uses vecmath are interchangeable.
public import vecmath.*

# A color: red, green, blue, and alpha (opacity), each 0 to 255.
struct Color
    int r = 255
    int g = 255
    int b = 255
    int a = 255

    # The same color at a different opacity, 0 (invisible) to 1.
    function fade(double opacity) returns Color
        return Color(this.r, this.g, this.b, int(math.round(math.clamp(opacity, 0.0, 1.0) * 255)))
    end
    function lerp(Color to, double t) returns Color
        return Color(mix(this.r, to.r, t), mix(this.g, to.g, t), mix(this.b, to.b, t),
            mix(this.a, to.a, t))
    end
    # Lighter (factor above 1) or darker (below 1).
    function brightness(double factor) returns Color
        return Color(scale_channel(this.r, factor), scale_channel(this.g, factor),
            scale_channel(this.b, factor), this.a)
    end
    # The color packed as red, green, blue, alpha bytes (as read_pixel returns it).
    function packed() returns int
        return ((this.r * 256 + this.g) * 256 + this.b) * 256 + this.a
    end
end

private function mix(int from, int to, double t) returns int
    return int(math.round(double(from) + double(to - from) * t))
end
private function scale_channel(int value, double factor) returns int
    return int(math.clamp(math.round(double(value) * factor), 0.0, 255.0))
end

# A color from "#rrggbb", "#rrggbbaa", or "#rgb" (the # is optional).
function hex(string text) returns Color
    var digits = text
    if digits.starts_with("#") do
        digits = digits[1..<digits.length]
    end
    if digits.length == 3 do
        var wide = ""
        for c in digits do
            wide = wide + c + c
        end
        digits = wide
    end
    if digits.length != 6 and digits.length != 8 do
        throw ValueError("hex colors look like #rrggbb or #rrggbbaa, not '" + text + "'")
    end
    int[] parts = []
    for i in 0..<digits.length // 2 do
        parts.push(hex_digit(digits[i * 2]) * 16 + hex_digit(digits[i * 2 + 1]))
    end
    return Color(parts[0], parts[1], parts[2], parts[3] if parts.length == 4 else 255)
end
private function hex_digit(char c) returns int
    var code = int(c)
    if code >= 48 and code <= 57 do
        return code - 48
    end
    if code >= 97 and code <= 102 do
        return code - 87
    end
    if code >= 65 and code <= 70 do
        return code - 55
    end
    throw ValueError("'" + c + "' is not a hexadecimal digit")
end
# A color from hue (degrees), saturation, and value (both 0 to 1).
function hsv(double hue, double saturation, double value) returns Color
    var h = (hue - math.floor(hue / 360) * 360) / 60
    var c = value * saturation
    var x = c * (1 - math.abs(h - math.floor(h / 2) * 2 - 1))
    var m = value - c
    var r = 0.0
    var g = 0.0
    var b = 0.0
    if h < 1 do
        r = c
        g = x
    else if h < 2 do
        r = x
        g = c
    else if h < 3 do
        g = c
        b = x
    else if h < 4 do
        g = x
        b = c
    else if h < 5 do
        r = x
        b = c
    else do
        r = c
        b = x
    end
    return Color(int(math.round((r + m) * 255)), int(math.round((g + m) * 255)),
        int(math.round((b + m) * 255)), 255)
end

const WHITE = Color(255, 255, 255, 255)
const BLACK = Color(0, 0, 0, 255)
const TRANSPARENT = Color(0, 0, 0, 0)
const GRAY = Color(130, 130, 130, 255)
const LIGHT_GRAY = Color(200, 200, 200, 255)
const DARK_GRAY = Color(60, 60, 68, 255)
const RED = Color(230, 41, 55, 255)
const ORANGE = Color(255, 150, 30, 255)
const YELLOW = Color(253, 224, 60, 255)
const GREEN = Color(40, 200, 90, 255)
const LIME = Color(150, 230, 60, 255)
const CYAN = Color(60, 210, 230, 255)
const BLUE = Color(50, 120, 240, 255)
const NAVY = Color(20, 28, 54, 255)
const PURPLE = Color(150, 90, 230, 255)
const PINK = Color(255, 110, 180, 255)
const BROWN = Color(130, 90, 60, 255)
const SKY = Color(120, 190, 255, 255)

# A rectangle: its top left corner and size.
struct Rect
    double x = 0
    double y = 0
    double w = 0
    double h = 0

    function right() returns double
        return this.x + this.w
    end
    function bottom() returns double
        return this.y + this.h
    end
    function center() returns Vec2
        return Vec2(this.x + this.w / 2, this.y + this.h / 2)
    end
    function position() returns Vec2
        return Vec2(this.x, this.y)
    end
    function size() returns Vec2
        return Vec2(this.w, this.h)
    end
    function contains(Vec2 point) returns bool
        return point.x >= this.x and point.x < this.x + this.w and point.y >= this.y and
            point.y < this.y + this.h
    end
    function overlaps(Rect other) returns bool
        return this.x < other.x + other.w and other.x < this.x + this.w and
            this.y < other.y + other.h and other.y < this.y + this.h
    end
    # The part both rectangles cover (zero size when they do not overlap).
    function intersection(Rect other) returns Rect
        var left = math.max(this.x, other.x)
        var top = math.max(this.y, other.y)
        var right = math.min(this.x + this.w, other.x + other.w)
        var bottom = math.min(this.y + this.h, other.y + other.h)
        if right <= left or bottom <= top do
            return Rect(left, top, 0, 0)
        end
        return Rect(left, top, right - left, bottom - top)
    end
    function moved(Vec2 by) returns Rect
        return Rect(this.x + by.x, this.y + by.y, this.w, this.h)
    end
    # Larger by `amount` on every side (smaller when negative).
    function grown(double amount) returns Rect
        return Rect(this.x - amount, this.y - amount, this.w + amount * 2, this.h + amount * 2)
    end
    # A rectangle of a size around a center point.
    static function centered(Vec2 center, double w, double h) returns Rect
        return Rect(center.x - w / 2, center.y - h / 2, w, h)
    end
end

# --- Window ----------------------------------------------------------------------------------

# Window options for open(), added together: aperture.RESIZABLE + aperture.MSAA.
const int RESIZABLE = 1
const int FULLSCREEN = 2
const int NO_VSYNC = 4
# No window on screen: for tests, tools, and rendering to files.
const int HIDDEN = 8
# Smooth edges (4x multisampling).
const int MSAA = 16
const int BORDERLESS = 32

private double collector_budget = 0.001

# Opens the game window. Only one window is open at a time.
function open(string title, int width, int height, int options = 0)
    nat.ap_open(title, width, height, options)
end
# Closes the window and frees everything loaded.
function close()
    nat.ap_close()
end
function is_open() returns bool
    return nat.ap_is_open()
end
# Starts the next frame: shows what the last one drew, reads input, and advances the clock.
# Returns false when the window should close, so a game is `while aperture.frame() do ... end`.
function frame() returns bool
    if collector_budget > 0 do
        gc.step(collector_budget)
    end
    return nat.ap_frame()
end
# Asks the game loop to end: the next frame() returns false.
function quit()
    nat.ap_request_close()
end
# Seconds the last frame took, for movement that does not depend on the frame rate.
function delta() returns double
    return nat.ap_delta()
end
# Seconds since the window opened.
function time() returns double
    return nat.ap_time()
end
function fps() returns double
    return nat.ap_fps()
end
function frame_count() returns int
    return nat.ap_frame_count()
end
# Limits the frame rate (0 removes the limit; vsync still applies).
function target_fps(int rate)
    nat.ap_target_fps(rate)
end
function vsync(bool on)
    nat.ap_vsync(on)
end
# How long frame() may spend collecting garbage cycles (default one millisecond; 0 leaves
# collection to the runtime's own schedule).
function collector_time(double seconds)
    collector_budget = seconds
end
# The width of the drawing area: the virtual size, the canvas being drawn to, or the window.
function width() returns double
    return double(nat.ap_width())
end
function height() returns double
    return double(nat.ap_height())
end
function size() returns Vec2
    return Vec2(double(nat.ap_width()), double(nat.ap_height()))
end
function center() returns Vec2
    return Vec2(double(nat.ap_width()) / 2, double(nat.ap_height()) / 2)
end
function window_size() returns Vec2
    return Vec2(double(nat.ap_window_width()), double(nat.ap_window_height()))
end
# Draw in a fixed coordinate space scaled to fit the window, with bars at the sides when the
# shapes differ. virtual_size(0, 0) turns it off.
function virtual_size(int width, int height)
    nat.ap_virtual_size(width, height)
end
function set_title(string title)
    nat.ap_set_title(title)
end
function set_size(int width, int height)
    nat.ap_set_size(width, height)
end
function fullscreen(bool on)
    nat.ap_fullscreen(on)
end
function is_fullscreen() returns bool
    return nat.ap_is_fullscreen()
end
function show_cursor(bool on)
    nat.ap_show_cursor(on)
end
# Hides the cursor and reports unbounded motion (mouse_delta), for first-person cameras.
function capture_mouse(bool on)
    nat.ap_capture_mouse(on)
end

