# Gallery: a small 3D scene. Drag with the left mouse button to look around, scroll to zoom,
# and point at a shape to name it.
#
#     flywheel run examples/gallery.fw
#
# Shows cameras, built-in and hand-built meshes, textures, lights, fog, picking with a ray,
# billboards, and 2D drawing on top of 3D.
import "../aperture.fw" as ap
import math

class Exhibit
    string name
    ap.Mesh mesh
    ap.Vec3 position
    ap.Color color
    double reach
end

ap.open("Gallery", 1280, 720, ap.RESIZABLE + ap.MSAA)

# A checkered floor, repeated across a large plane.
var checks = ap.make_texture(2, 2, function(int x, int y) returns ap.Color
    return ap.Color(70, 76, 96) if (x + y) % 2 == 0 else ap.Color(48, 52, 70)
end)
checks.repeat(true)
var floor = ap.plane(40, 40, 20)

# A soft round sprite for the lamp, drawn as a billboard.
var halo = ap.make_texture(32, 32, function(int x, int y) returns ap.Color
    var distance = ap.Vec2(double(x) - 15.5, double(y) - 15.5).length() / 16
    return ap.WHITE.fade(ap.smooth(1 - distance) * 0.9)
end, true)

# A mesh built by hand: a four-sided pyramid.
function pyramid() returns ap.Mesh
    var builder = ap.MeshBuilder()
    var apex = ap.Vec3(0, 0.6, 0)
    var corners = [ap.Vec3(-0.5, -0.4, 0.5), ap.Vec3(0.5, -0.4, 0.5), ap.Vec3(0.5, -0.4, -0.5),
        ap.Vec3(-0.5, -0.4, -0.5)]
    for i in 0..<4 do
        var a = corners[i]
        var b = corners[(i + 1) % 4]
        var normal = (b - a).cross(apex - a).normalized()
        builder.triangle(builder.vertex(a, normal), builder.vertex(b, normal),
            builder.vertex(apex, normal))
    end
    var down = ap.Vec3(0, -1, 0)
    builder.quad(builder.vertex(corners[3], down), builder.vertex(corners[2], down),
        builder.vertex(corners[1], down), builder.vertex(corners[0], down))
    return builder.build()
end

var bulb = ap.sphere(0.12, 8, 12)
Exhibit[] exhibits = [
    Exhibit("cube", ap.cube(1.2, 1.2, 1.2), ap.Vec3(0, 0, 0), ap.ORANGE, 1.0),
    Exhibit("sphere", ap.sphere(0.75), ap.Vec3(0, 0, 0), ap.CYAN, 0.75),
    Exhibit("torus", ap.torus(0.6, 0.22), ap.Vec3(0, 0, 0), ap.PINK, 0.8),
    Exhibit("cone", ap.cone(0.6, 1.4), ap.Vec3(0, 0, 0), ap.LIME, 0.8),
    Exhibit("cylinder", ap.cylinder(0.5, 1.3), ap.Vec3(0, 0, 0), ap.PURPLE, 0.8),
    Exhibit("pyramid (hand-built)", pyramid(), ap.Vec3(0, 0, 0), ap.YELLOW, 0.8)
]
for i, exhibit in exhibits do
    var angle = double(i) / double(exhibits.length) * math.TAU
    exhibit.position = ap.Vec3(math.cos(angle) * 4, 1.1, math.sin(angle) * 4)
end

var yaw = 35.0
var pitch = 22.0
var distance = 11.0
ap.ambient(ap.Color(60, 62, 80))
ap.sun(ap.Vec3(-0.5, -1, -0.3), ap.Color(255, 240, 220))
ap.shine(0.5, 48)
ap.fog(ap.NAVY, 14, 34)

while ap.frame() do
    if ap.mouse_down(ap.MOUSE_LEFT) do
        var motion = ap.mouse_delta()
        yaw -= motion.x * 0.3
        pitch = math.clamp(pitch + motion.y * 0.3, 4.0, 80.0)
    else do
        yaw += 6 * ap.delta()
    end
    distance = math.clamp(distance - ap.wheel().y, 5.0, 24.0)
    if ap.key_pressed(ap.KEY_ESCAPE) do
        ap.quit()
    end
    ap.wireframe(ap.key_down(ap.KEY_TAB))

    var camera = ap.orbit(ap.Vec3(0, 1, 0), yaw, pitch, distance)
    var lamp = ap.Vec3(math.cos(ap.time() * 0.9) * 2, 1.6 + math.sin(ap.time() * 1.7) * 0.5,
        math.sin(ap.time() * 0.9) * 2)
    ap.light(0, lamp, ap.Color(255, 200, 120), 9)

    ap.clear(ap.NAVY)
    ap.begin_3d(camera)
    ap.draw(floor, ap.Vec3(0, 0, 0), ap.WHITE, ap.Vec3(0, 0, 0), ap.Vec3(1, 1, 1), checks)

    # The exhibit under the mouse is the nearest one its ray hits.
    var ray = ap.screen_ray(ap.mouse())
    var pointed = -1
    var nearest = math.INF
    for i, exhibit in exhibits do
        var hit = ray.hits_sphere(exhibit.position, exhibit.reach)
        if hit >= 0 and hit < nearest do
            nearest = hit
            pointed = i
        end
    end
    for i, exhibit in exhibits do
        var turn = ap.time() * 40 + double(i) * 60
        var tint = exhibit.color.brightness(1.35) if i == pointed else exhibit.color
        var lift = 0.25 if i == pointed else 0.0
        ap.draw(exhibit.mesh, exhibit.position + ap.Vec3(0, lift, 0), tint, ap.Vec3(turn * 0.5, turn, 0))
        # A pedestal under each one.
        ap.push_3d()
        ap.translate_3d(ap.Vec3(exhibit.position.x, 0.15, exhibit.position.z))
        ap.scale_3d(ap.Vec3(1.4, 0.3, 1.4))
        ap.draw(exhibits[0].mesh, ap.Vec3(0, 0, 0), ap.Color(90, 94, 110), ap.Vec3(0, 0, 0),
            ap.Vec3(1 / 1.2, 1 / 1.2, 1 / 1.2))
        ap.pop_3d()
    end

    # The lamp: an unlit bulb with a glow that always faces the camera.
    ap.lighting(false)
    ap.draw(bulb, lamp, ap.Color(255, 230, 170))
    ap.lighting(true)
    ap.blend(ap.BLEND_ADD)
    ap.depth_write(false)
    ap.billboard(halo, lamp, 1.6, ap.Color(255, 190, 110))
    ap.depth_write(true)
    ap.blend(ap.BLEND_ALPHA)

    # Labels are placed where the exhibits appear on screen.
    var label = ap.Vec2(0, 0)
    if pointed >= 0 do
        label = ap.project(exhibits[pointed].position + ap.Vec3(0, 1.4, 0))
    end
    ap.end_3d()

    if pointed >= 0 do
        var name = exhibits[pointed].name
        var box = ap.measure(name, 16)
        ap.fill(ap.Rect.centered(label, box.x + 16, box.y + 10), ap.BLACK.fade(0.6))
        ap.text_centered(name, label.x, label.y, 16, ap.WHITE)
    end
    ap.text("Drag to look around, scroll to zoom, hold Tab for wireframe", 16, 16, 16)
    ap.text("{int(ap.fps())} fps", 16, ap.height() - 28, 16, ap.GRAY)
end
ap.close()
